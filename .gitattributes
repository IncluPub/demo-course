# Line feeds, as the canonical form of sources requires
* text=auto eol=lf

# Media in Git LFS
media/*.jpg filter=lfs diff=lfs merge=lfs -text
media/*.jpeg filter=lfs diff=lfs merge=lfs -text
media/*.png filter=lfs diff=lfs merge=lfs -text
media/*.gif filter=lfs diff=lfs merge=lfs -text
media/*.webp filter=lfs diff=lfs merge=lfs -text
media/*.mp4 filter=lfs diff=lfs merge=lfs -text
media/*.m4v filter=lfs diff=lfs merge=lfs -text
media/*.mp3 filter=lfs diff=lfs merge=lfs -text
media/*.m4a filter=lfs diff=lfs merge=lfs -text
